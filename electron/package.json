{
  "name": "groodchat-desktop",
  "desktopName": "groodchat.desktop",
  "version": "0.6.5",
  "private": true,
  "description": "Open-source chat client customized from Outpost.",
  "main": "main.js",
  "homepage": "https://github.com/mtzeclipse01-lgtm/GroodChat",
  "author": {
    "name": "blindrun",
    "email": "blindrungaming@gmail.com"
  },
  "scripts": {
    "build-web": "node scripts/build-web.js",
    "dev": "npm run build-web && electron .",
    "dist": "npm run build-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.groodchat.desktop",
    "productName": "GroodChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-dist/**/*"
    ],
    "protocols": [
      {
        "name": "GroodChat",
        "schemes": [
          "outpost"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mtzeclipse01-lgtm",
      "repo": "GroodChat"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GroodChat needs microphone access to let you talk in voice channels.",
        "NSCameraUsageDescription": "GroodChat needs camera access for video in voice channels."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Self-hosted chat client",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  }
}
